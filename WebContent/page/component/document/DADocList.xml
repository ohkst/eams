scwin.onpageload = function() {
   
    const param = {
        offset: 0,
        limit: 1000,
        type: "PAGE"
    }

    $c.sbm.execute(sbmDASystemList, param);
};

scwin.btnSearch_onclick = function (e) {
    dbs.clearFilter();

    let jsonFilterOptions = {};

    jsonFilterOptions.type = "row";
    jsonFilterOptions.colIndex = "istcName";
    jsonFilterOptions.key = tfBizName.getValue();
    jsonFilterOptions.exactMatch = false;
    jsonFilterOptions.condition = "and";

    dbs.setColumnFilter(jsonFilterOptions);

    let jsonFilterOptions2 = {};

    jsonFilterOptions2.type = "row";
    jsonFilterOptions2.colIndex = "dvlpChrrName";
    jsonFilterOptions2.key = tfOwnerName.getValue();
    jsonFilterOptions2.exactMatch = false;
    jsonFilterOptions2.condition = "and";

    dbs.setColumnFilter(jsonFilterOptions2);
};

scwin.btnReset_onclick = function (e) {
    tfBizName.setValue("");
    tfOwnerName.setValue("");
    dbs.clearFilter();
};

scwin.imgBtnCSV_onclick = function (e) {
    var jsnOptions;
    var today = $c.date.getServerDateTime("yyyyMMddHHmmss");
    jsnOptions = {
        fileName: "TestCSV" + today + ".csv"
    };

    grdSystemList.saveCSV(jsnOptions);
};


scwin.grdSystemList_oncellclick = function (rowIndex, columnIndex, columnId) {
    var rowJSON = {
        "id": dbs.getCellData(rowIndex, "dbAdmnId"),
        "type":"DA"
    };

    var dataObject = {
        "type": "json",
        "name": "PopupData",
        "data": rowJSON
    };

    $c.util.openEamsPopup("/page/component/document/PopupDetailDocList.xml", "스키마 리스트", dataObject);
};

scwin.openDocDetailPopup = function (id, name) {
    
    setTimeout(function () {
        var rowJSON = {
            "id": id,
            "name": name,
            "type": "DA"
        };

        var dataObject = {
            "type": "json",
            "name": "PopupData",
            "data": rowJSON
        };

        $c.util.openEamsPopup("/page/component/document/PopupDocumentDetail.xml", "문서 상세", dataObject);
    }, 300);
};

scwin.closeAction = function (id, info) {

    if (!info.isCloseButtonClick) {
        return true;
    }

    return true
};

scwin.sbmDASystemList_submitdone = function (e) {

};
]]></script>
